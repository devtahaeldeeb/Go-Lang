package main

import "github.com/01-edu/z01"
func main() {

	for i := 0; i < 98; i++ {
		for j := i + 1; j <= 99; j++ {
			z01.PrintRune(i/10 + '0')
			z01.PrintRune(i%10 + '0')
			z01.PrintRune(' ')
			z01.PrintRune(j/10 + '0')
			z01.PrintRune(j%10 + '0')

			if !(i == 98 && j == 99) {
				z01.PrintRune(',')
				z01.PrintRune(' ')
			}
		}
	}
}
