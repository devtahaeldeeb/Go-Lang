package main

import "github.com/01-edu/z01"

func PrintCombN(n int) {
	if n <= 0 || n >= 10 {
		return
	}

	backtrack(n, []int{})
}

func backtrack(n int, current []int) {
	if len(current) == n {
		for _, digit := range current {
			z01.PrintRune(rune(digit + '0'))
		}

		if current[0] != 10-n {
			z01.PrintRune(',')
			z01.PrintRune(' ')
		}
		return
	}

	start := 0
	if len(current) > 0 {
		start = current[len(current)-1] + 1
	}

	for i := start; i <= 9; i++ {
		current = append(current, i)

		backtrack(n, current)

		current = current[:len(current)-1]
	}
}

func main() {
	// PrintCombN(-4)
	// z01.PrintRune('\n')
	// PrintCombN(-2)
	// z01.PrintRune('\n')
	PrintCombN(1)
	z01.PrintRune('\n')
	PrintCombN(0)
	z01.PrintRune('\n')
	PrintCombN(-1)
	z01.PrintRune('\n')
	PrintCombN(2)
	z01.PrintRune('\n')
	PrintCombN(3)
	z01.PrintRune('\n')
	PrintCombN(6)
	z01.PrintRune('\n')
}
